NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JOIN_RATE_LIMIT_SECRET=
# Random secret that authorises the daily wallet-sync retry job (Vercel sends it automatically).
CRON_SECRET=

# AIKIA's own team: comma-separated emails that may open /platform (all venues).
PLATFORM_ADMIN_EMAILS=

# Platform identity (white-label). Leave empty for AIKIA.WALLET defaults.
NEXT_PUBLIC_PLATFORM_NAME=
NEXT_PUBLIC_PLATFORM_SHORT_NAME=
NEXT_PUBLIC_PLATFORM_MARK=
NEXT_PUBLIC_PLATFORM_SUPPORT_EMAIL=

# Wallet engine: "passkit" (active) or "direct" (our own Google/Apple adapters).
WALLET_ENGINE=passkit

# PassKit (Developer Tools in app.passkit.com). EU accounts use https://api.pub1.passkit.io, USA https://api.pub2.passkit.io.
PASSKIT_API_BASE_URL=https://api.pub1.passkit.io
PASSKIT_API_KEY=
PASSKIT_API_SECRET=
PASSKIT_PROGRAM_ID=
# Optional: map our tier names to PassKit tier IDs when they differ from the lowercase name, e.g. {"Ink":"base"}.
PASSKIT_TIER_IDS=
# Set to true once the Apple certificate is uploaded to PassKit and the project is launched.
PASSKIT_APPLE_ENABLED=false

# Direct engine only (WALLET_ENGINE=direct). WALLET_PROVIDERS is a comma list: google or google,apple.
WALLET_PROVIDERS=google
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
GOOGLE_WALLET_PROGRAM_LOGO_URL=
